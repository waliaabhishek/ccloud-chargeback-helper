        echo "A Demo media stack already exists. Inspect it or run './demo media down' before capturing again." >&2
        exit 1
    fi
}

media_capture() {
    local source_commit source_worktree_clean output status spec_result git_status spec_profile spec_anchor
    media_set_environment
    media_check_interactive_stack
    media_check_retained_stack

    if ! source_commit=$(git rev-parse HEAD 2>/dev/null); then
        echo "Unable to identify the Demo media source commit." >&2
        exit 1
    fi
    if ! git_status=$(git status --porcelain 2>/dev/null); then
        echo "Unable to determine the Demo media source worktree state." >&2
        exit 1
    fi
    if [[ -z "${git_status}" ]]; then
        source_worktree_clean=true
    else
        source_worktree_clean=false
    fi

    if output=$(media_compose build chitragupta chitragupta-ui media-capture 2>&1); then
        printf '%s\n' "${output}"
    else
        status=$?
        printf '%s\n' "${output}" >&2
        media_prestart_failure "${status}" "Demo media checkout build failed."
    fi
    if output=$(media_compose pull media-encoder 2>&1); then
        printf '%s\n' "${output}"
    else
        status=$?
        printf '%s\n' "${output}" >&2
        media_prestart_failure "${status}" "Demo media encoder acquisition failed."
    fi
    if ! mkdir -p -- "${DEMO_MEDIA_DIR}" "${DEMO_STATE_DIR}"; then
        media_prestart_failure 1 "Unable to prepare Demo media bind-mount directories."
    fi
    if spec_result=$(media_compose run --rm --no-deps media-tool spec --spec /opt/chitragupta-demo-media/capture-spec.json 2>&1); then
        printf '%s\n' "${spec_result}"
    else
        status=$?
        printf '%s\n' "${spec_result}" >&2
        media_prestart_failure "${status}" "Invalid Demo media capture specification."
    fi

    spec_profile=$(printf '%s\n' "${spec_result}" | sed -n 's/.*"profile"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    spec_anchor=$(printf '%s\n' "${spec_result}" | sed -n 's/.*"anchor_date"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    if [[ "${spec_profile}" != showcase || ! "${spec_anchor}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        media_prestart_failure 1 "Demo media specification did not provide a valid profile and anchor."
    fi
    DEMO_PROFILE=${spec_profile}
    DEMO_ANCHOR_DATE=${spec_anchor}
    export DEMO_PROFILE DEMO_ANCHOR_DATE

    rm -rf -- "${DEMO_MEDIA_DIR}"
    mkdir -p -- "${DEMO_MEDIA_DIR}/state" "${DEMO_MEDIA_DIR}/assets" "${DEMO_MEDIA_DIR}/work"

    if output=$(media_compose run --rm demo-generator 2>&1); then
        printf '%s\n' "${output}"
    else
        status=$?
        printf '%s\n' "${output}" >&2
        media_prestart_failure "${status}" "Demo media generation failed."
    fi
    if output=$(media_compose run --rm --no-deps media-tool catalog \
        --spec /opt/chitragupta-demo-media/capture-spec.json \
        --config /app/config/config.yaml \
        --output /app/media/work/synthetic-catalog.json \
        --srt-output /app/media/work/captions.srt \
        --state-dir /app/media/state 2>&1); then
        printf '%s\n' "${output}"
    else
        status=$?
        printf '%s\n' "${output}" >&2
        media_prestart_failure "${status}" "Demo media catalog validation failed."
    fi

    if output=$(media_compose up --detach --wait --force-recreate chitragupta chitragupta-ui 2>&1); then
        printf '%s\n' "${output}"
    else
        status=$?
        printf '%s\n' "${output}" >&2
        media_poststart_failure "${status}" "Demo media API/UI startup failed."
    fi
    if output=$(media_compose run --rm --no-deps media-capture \
        --spec /opt/chitragupta-demo-media/capture-spec.json \
        --catalog /app/media/work/synthetic-catalog.json \
        --output /app/media 2>&1); then
        printf '%s\n' "${output}"
    else
        status=$?
        printf '%s\n' "${output}" >&2
        media_poststart_failure "${status}" "Demo media browser capture failed."
    fi
    if output=$(media_compose run --rm --no-deps media-encoder \
        /opt/chitragupta-demo-media/capture-spec.json /app/media 2>&1); then
        printf '%s\n' "${output}"
    else
        status=$?
        printf '%s\n' "${output}" >&2
        media_poststart_failure "${status}" "Demo media encoding failed."
    fi
    if output=$(media_compose stop chitragupta chitragupta-ui 2>&1); then
        printf '%s\n' "${output}"
    else
        status=$?
        printf '%s\n' "${output}" >&2
        media_poststart_failure "${status}" "Demo media API/UI shutdown failed."
    fi
    if output=$(media_compose run --rm --no-deps media-tool catalog \
        --spec /opt/chitragupta-demo-media/capture-spec.json \
        --config /app/config/config.yaml \
        --output /app/media/work/synthetic-catalog.json \
        --srt-output /app/media/work/captions.srt \
        --state-dir /app/media/state 2>&1); then
        printf '%s\n' "${output}"
    else
        status=$?
        printf '%s\n' "${output}" >&2
        media_poststart_failure "${status}" "Demo media final catalog validation failed."
    fi
    if output=$(media_compose run --rm --no-deps media-tool manifest \
        --spec /opt/chitragupta-demo-media/capture-spec.json \
        --media-root /app/media \
        --source-commit "${source_commit}" \
        --source-worktree-clean "${source_worktree_clean}" 2>&1); then
        printf '%s\n' "${output}"
    else
        status=$?
        printf '%s\n' "${output}" >&2
        media_poststart_failure "${status}" "Demo media manifest validation failed."
    fi
    if [[ "${source_worktree_clean}" == false ]]; then
        if ! mkdir -p -- docs/assets/demo ||
            ! cat -- "${DEMO_MEDIA_DIR}/assets/chitragupta-demo-dashboard-poster.webp" \
                > docs/assets/demo/chitragupta-demo-dashboard-poster.webp; then
            media_poststart_failure 1 "Demo media poster copy failed."
        fi
        echo "Reviewed poster: docs/assets/demo/chitragupta-demo-dashboard-poster.webp (copied from .demo/media/assets/chitragupta-demo-dashboard-poster.webp)"
    else
        echo "Release poster: .demo/media/assets/chitragupta-demo-dashboard-poster.webp (tracked poster unchanged)"
    fi
    if output=$(media_compose down 2>&1); then
        printf '%s\n' "${output}"
    else
        status=$?
        printf '%s\n' "${output}" >&2
        media_poststart_failure "${status}" "Demo media teardown failed."
    fi
    echo "Demo media capture complete: ${DEMO_MEDIA_PATH}"
}

