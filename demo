}

media_publish() {
    local output status source_commit source_worktree_clean manifest_path captured_commit stable_tag stable_release git_status
    local stable_probe_status stable_probe_output stable_release_status release_view_status release_output
    media_set_environment
    command -v git >/dev/null 2>&1 || { echo "git is required for Demo media publication." >&2; exit 1; }
    command -v gh >/dev/null 2>&1 || { echo "gh is required for Demo media publication." >&2; exit 1; }
    if output=$(media_compose run --pull never --rm --no-deps media-tool validate \
        --spec /opt/chitragupta-demo-media/capture-spec.json \
        --media-root /app/media 2>&1); then
        printf '%s\n' "${output}"
    else
        status=$?
        printf '%s\n' "${output}" >&2
        echo "Demo media validation failed; publication was not attempted." >&2
        echo "Validated Demo media is unavailable. Run './demo media' first." >&2
        exit "${status}"
    fi
    manifest_path="${DEMO_MEDIA_DIR}/manifest.json"
    if [[ ! -f "${manifest_path}" ]]; then
        echo "Validated Demo media is unavailable. Run './demo media' first." >&2
        exit 1
    fi
    source_commit=$(git rev-parse HEAD 2>/dev/null) || {
        echo "Unable to identify the Demo media source commit." >&2
        exit 1
    }
    if ! git_status=$(git status --porcelain 2>/dev/null); then
        echo "Unable to determine the Demo media source worktree state." >&2
        exit 1
    fi
    if [[ -n "${git_status}" ]]; then
        echo "Demo media publication requires a clean worktree." >&2
        exit 1
    fi
    captured_commit=$(sed -n 's/.*"source_commit"[[:space:]]*:[[:space:]]*"\([0-9a-f]\{40\}\)".*/\1/p' "${manifest_path}" 2>/dev/null || true)
    if [[ -n "${captured_commit}" && "${captured_commit}" != "${source_commit}" ]]; then
        echo "Demo media source commit ${captured_commit} does not match current HEAD ${source_commit}. Run './demo media'." >&2
        exit 1
    fi
    source_worktree_clean=$(sed -n 's/.*"source_worktree_clean"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' "${manifest_path}" 2>/dev/null || true)
    if [[ "${source_worktree_clean}" == false ]]; then
        echo "Validated Demo media is unavailable. Run './demo media' first." >&2
        exit 1
    fi

    stable_tag=
    stable_probe_status=0
    stable_probe_output=
    if stable_probe_output=$(git describe --tags --exact-match --match 'v*.*.*' HEAD 2>&1); then
        stable_tag=${stable_probe_output}
    else
        stable_probe_status=$?
        if ((stable_probe_status != 128)); then
            printf '%s\n' "${stable_probe_output}" >&2
            echo "Unable to inspect the source stable tag (git describe exited ${stable_probe_status})." >&2
            exit "${stable_probe_status}"
        fi
        case "${stable_probe_output}" in
            "fatal: no tag exactly matches '"*"'") ;;
            *)
                printf '%s\n' "${stable_probe_output}" >&2
                echo "Unable to inspect the source stable tag (git describe exited ${stable_probe_status})." >&2
                exit "${stable_probe_status}"
                ;;
        esac
    fi
    if ((stable_probe_status == 0)) && [[ ! "${stable_tag}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        stable_tag=
    fi
    if [[ -n "${stable_tag}" ]]; then
        stable_release=
        stable_release_status=0
        stable_release=$(gh release view "${stable_tag}" --json isDraft,isPrerelease 2>&1) || stable_release_status=$?
        if ((stable_release_status > 1)); then
            echo "Unable to verify the source release ${stable_tag} (gh release view exited ${stable_release_status})." >&2
            exit "${stable_release_status}"
        fi
        if ((stable_release_status == 1)) && [[ -z "${stable_release}" || "${stable_release}" == *"release not found"* ||
            "${stable_release}" == *"HTTP 404"* ]]; then
            echo "WARNING: stable tag ${stable_tag} has no published GitHub Release; continuing."
            stable_tag=
        elif ((stable_release_status != 0)); then
            printf '%s\n' "${stable_release}" >&2
            echo "Unable to verify the source release ${stable_tag}." >&2
            exit "${stable_release_status}"
        elif [[ "${stable_release}" == *'"isDraft":true'* ||
            "${stable_release}" == *'"isDraft": true'* ||
            "${stable_release}" == *'"isPrerelease":true'* ||
            "${stable_release}" == *'"isPrerelease": true'* ]]; then
            stable_tag=
        fi
    fi
    if [[ -z "${stable_tag}" ]]; then
        echo "WARNING: source commit ${source_commit} is not a published stable release; demo media may be newer than the default GHCR images. Continuing."
    fi

    release_view_status=0
    release_output=$(gh release view demo-media --json isDraft,isPrerelease,isLatest,url 2>&1) || release_view_status=$?
    if ((release_view_status == 0)); then
        output=
        if output=$(gh release edit demo-media --draft=false --prerelease=false --latest=false 2>&1); then
            :
        else
            status=$?
            printf '%s\n' "${output}" >&2
            echo "Demo media GitHub Release edit failed (gh exited ${status})." >&2
            exit "${status}"
        fi
    elif ((release_view_status == 1)) && [[ -z "${release_output}" || "${release_output}" == *"release not found"* ||
        "${release_output}" == *"HTTP 404"* ]]; then
        output=
        if output=$(gh release create demo-media --title "Chitragupta Demo Media" --notes "Synthetic Demo Experience media." --latest=false 2>&1); then
            :
        else
            status=$?
            printf '%s\n' "${output}" >&2
            echo "Demo media GitHub Release creation failed (gh exited ${status})." >&2
            exit "${status}"
        fi
    else
        printf '%s\n' "${release_output}" >&2
        echo "Unable to inspect the demo-media GitHub Release (gh release view exited ${release_view_status})." >&2
        exit "${release_view_status}"
    fi
    if output=$(gh release upload demo-media \
        "${DEMO_MEDIA_DIR}/assets/chitragupta-demo-dashboard.png" \
        "${DEMO_MEDIA_DIR}/assets/chitragupta-demo-cost-explorer.png" \
        "${DEMO_MEDIA_DIR}/assets/chitragupta-demo-topic-attribution.png" \
        "${DEMO_MEDIA_DIR}/assets/chitragupta-demo-pipeline-status.png" \
        "${DEMO_MEDIA_DIR}/assets/chitragupta-demo-focus-mapping-preview.png" \
        "${DEMO_MEDIA_DIR}/assets/chitragupta-demo-walkthrough.mp4" \
        "${DEMO_MEDIA_DIR}/manifest.json" --clobber 2>&1); then
        :
    else
        status=$?
        printf '%s\n' "${output}" >&2
        echo "Demo media GitHub Release upload failed (gh exited ${status})." >&2
        exit "${status}"
    fi
    printf '%s\n' "${output}"
    if [[ -n "${release_output:-}" ]]; then
        printf '%s\n' "${release_output}"
    else
        echo "https://github.com/waliaabhishek/chitragupta/releases/tag/demo-media"
    fi
}

DEMO_ACTION=start
DEMO_PROFILE=
DEMO_GRAFANA_ENABLED=0
DEMO_LAN_ENABLED=0
DEMO_BUILD=0
DEMO_UI_PORT=8081
DEMO_API_PORT=8080
DEMO_GRAFANA_PORT=3000

if (($# == 0)); then
    DEMO_PROFILE=clean
elif [[ "$1" == reset ]]; then
    DEMO_ACTION=reset
    if (($# == 1)); then
        :
    elif (($# == 2)) && [[ "$2" == --clean || "$2" == --showcase ]]; then
        DEMO_PROFILE=${2#--}
    else
        invalid_usage
    fi
elif [[ "$1" == media ]]; then
    DEMO_PROFILE=
    if (($# == 1)); then
        DEMO_ACTION=media_capture
    elif (($# == 2)); then
        case "$2" in
            publish) DEMO_ACTION=media_publish ;;
            status) DEMO_ACTION=media_status ;;
            logs) DEMO_ACTION=media_logs ;;
            down) DEMO_ACTION=media_down ;;
            *) invalid_usage ;;
        esac
    else
        invalid_usage
    fi
elif [[ "$1" == status || "$1" == logs || "$1" == down ]]; then
    (($# == 1)) || invalid_usage
    DEMO_ACTION=$1
else
    while (($# > 0)); do
        case "$1" in
            --showcase) DEMO_PROFILE=showcase ;;
            --grafana) DEMO_GRAFANA_ENABLED=1 ;;
            --lan) DEMO_LAN_ENABLED=1 ;;
            --build) DEMO_BUILD=1 ;;
            --ui-port|--api-port|--grafana-port)
                local_switch=$1
                if (($# < 2)); then
                    local_value=
                else
                    local_value=$2
                    shift
                fi
                parse_port "$local_switch" "$local_value"
                case "$local_switch" in
                    --ui-port) DEMO_UI_PORT=$PARSED_PORT ;;
                    --api-port) DEMO_API_PORT=$PARSED_PORT ;;
                    --grafana-port) DEMO_GRAFANA_PORT=$PARSED_PORT ;;
                esac
                ;;
            *) invalid_usage ;;
        esac
        shift
    done
    [[ -n "$DEMO_PROFILE" ]] || DEMO_PROFILE=clean
fi
if [[ "$DEMO_ACTION" != reset && "$DEMO_ACTION" != media_capture && "$DEMO_ACTION" != media_publish &&
    "$DEMO_ACTION" != media_status && "$DEMO_ACTION" != media_logs && "$DEMO_ACTION" != media_down &&
    -z "$DEMO_PROFILE" ]]; then
    DEMO_PROFILE=clean
fi

SCRIPT_PATH=${BASH_SOURCE[0]}
case "$SCRIPT_PATH" in
    */*) REPO_DIR=${SCRIPT_PATH%/*} ;;
    *) REPO_DIR=. ;;
esac
REPO_ROOT=$(CDPATH= cd -- "$REPO_DIR" && pwd)
cd "$REPO_ROOT"

if [[ "$DEMO_ACTION" == reset && -z "$DEMO_PROFILE" ]]; then
    ACTIVE_PROFILE_FILE=.demo/active-profile
    if [[ -e "$ACTIVE_PROFILE_FILE" ]]; then
        if [[ ! -f "$ACTIVE_PROFILE_FILE" ]]; then
            echo "Invalid active Demo profile. Use './demo reset --clean' or './demo reset --showcase'." >&2
            exit 1
        fi
        ACTIVE_PROFILE=
        active_profile_status=0
        IFS= read -r -d '' ACTIVE_PROFILE < "$ACTIVE_PROFILE_FILE" || active_profile_status=$?
        if ((active_profile_status != 1)); then
            echo "Invalid active Demo profile. Use './demo reset --clean' or './demo reset --showcase'." >&2
            exit 1
        fi
        case "$ACTIVE_PROFILE" in
            $'clean\n') DEMO_PROFILE=clean ;;
            $'showcase\n') DEMO_PROFILE=showcase ;;
            *)
                invalid_active_profile=${ACTIVE_PROFILE%$'\n'}
                echo "Invalid active Demo profile '$invalid_active_profile'. Use './demo reset --clean' or './demo reset --showcase'." >&2
                exit 1
                ;;
        esac
    else
        DEMO_PROFILE=clean
    fi
fi

if [[ "$DEMO_ACTION" == media_* ]]; then
    DEMO_STATE_PATH=.demo/state/media
    DEMO_STATE_DIR=
else
    case "$DEMO_PROFILE" in
        clean) DEMO_STATE_PATH=.demo/state/clean; DEMO_STATE_DIR=../../.demo/state/clean ;;
        showcase) DEMO_STATE_PATH=.demo/state/showcase; DEMO_STATE_DIR=../../.demo/state/showcase ;;
        *) echo "Unsupported Demo profile '$DEMO_PROFILE'" >&2; exit 1 ;;
    esac
fi
export DEMO_PROFILE DEMO_STATE_DIR

