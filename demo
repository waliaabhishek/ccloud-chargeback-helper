    COMPOSE=(docker-compose)
else
    echo "Docker with Compose support is required" >&2
    exit 1
fi

if ! DEMO_UID=$(id -u) || [[ ! "$DEMO_UID" =~ ^[0-9]+$ ]]; then
    echo "Numeric UID/GID could not be determined" >&2
    exit 1
fi
if ! DEMO_GID=$(id -g) || [[ ! "$DEMO_GID" =~ ^[0-9]+$ ]]; then
    echo "Numeric UID/GID could not be determined" >&2
    exit 1
fi
export DEMO_UID DEMO_GID

if [[ "$DEMO_ACTION" == media_capture ]]; then
    media_capture
    exit $?
elif [[ "$DEMO_ACTION" == media_publish ]]; then
    media_publish
    exit $?
elif [[ "$DEMO_ACTION" == media_status || "$DEMO_ACTION" == media_logs || "$DEMO_ACTION" == media_down ]]; then
    media_diagnostic
fi

if [[ "$DEMO_ACTION" == status || "$DEMO_ACTION" == logs || "$DEMO_ACTION" == down ]]; then
    DEMO_BIND_ADDRESS=127.0.0.1
    export DEMO_BIND_ADDRESS DEMO_UI_PORT DEMO_API_PORT DEMO_GRAFANA_PORT
    case "$DEMO_ACTION" in
        status) "${COMPOSE[@]}" "${ALL_COMPOSE[@]}" ps ;;
        logs) "${COMPOSE[@]}" "${ALL_COMPOSE[@]}" logs ;;
        down) "${COMPOSE[@]}" "${ALL_COMPOSE[@]}" down ;;
    esac
    exit $?
fi

DEMO_PLATFORM=$(uname -s 2>/dev/null || echo Linux)
if ((DEMO_LAN_ENABLED)); then
    DEMO_BIND_ADDRESS=0.0.0.0
    resolve_lan_address "$DEMO_PLATFORM" || exit 1
else
    DEMO_BIND_ADDRESS=127.0.0.1
    DEMO_DISPLAY_HOST=127.0.0.1
fi
export DEMO_BIND_ADDRESS DEMO_DISPLAY_HOST DEMO_UI_PORT DEMO_API_PORT DEMO_GRAFANA_PORT

check_duplicate_ports || exit 1
AMBIGUOUS_SERVICES=()
AMBIGUOUS_PORTS=()
AMBIGUOUS_PIDS=()
AMBIGUOUS_COMMANDS=()
preflight_ports "$DEMO_GRAFANA_ENABLED" || exit 1

if [[ "$DEMO_ACTION" == reset ]]; then
    echo "Resetting $DEMO_PROFILE demo state at $DEMO_STATE_PATH"
    "${COMPOSE[@]}" "${ALL_COMPOSE[@]}" stop chitragupta chitragupta-ui grafana
    case "$DEMO_PROFILE" in
        clean) rm -rf -- .demo/state/clean ;;
        showcase) rm -rf -- .demo/state/showcase ;;
    esac
fi

if ((DEMO_BUILD)); then
    DEMO_IMAGE_TAG=local
else
    resolve_release_tag
fi
export DEMO_IMAGE_TAG

if ((DEMO_GRAFANA_ENABLED)); then
    COMPOSE_FILES=("${ALL_COMPOSE[@]}")
else
    COMPOSE_FILES=("${BASE_COMPOSE[@]}")
fi

mkdir -p "$DEMO_STATE_PATH"
if ! DEMO_ANCHOR_DATE=$(date -u +%F); then
    echo "Unable to determine the current UTC date" >&2
    exit 1
fi
export DEMO_ANCHOR_DATE

if ((DEMO_BUILD)); then
    if ((DEMO_GRAFANA_ENABLED)); then
        if "${COMPOSE[@]}" "${COMPOSE_FILES[@]}" pull grafana; then :; else
            status=$?
            echo "Grafana image acquisition failed." >&2
            exit "$status"
        fi
    fi
    if "${COMPOSE[@]}" "${COMPOSE_FILES[@]}" build chitragupta chitragupta-ui; then :; else
        status=$?
        echo "checkout build failed." >&2
        exit "$status"
    fi
else
    pull_services=(chitragupta chitragupta-ui)
    ((DEMO_GRAFANA_ENABLED)) && pull_services+=(grafana)
    if "${COMPOSE[@]}" "${COMPOSE_FILES[@]}" pull "${pull_services[@]}"; then :; else
        status=$?
        echo "released-image acquisition failed." >&2
        exit "$status"
    fi
fi

if "${COMPOSE[@]}" "${COMPOSE_FILES[@]}" run --rm demo-generator; then :; else
    status=$?
    echo "Demo generation failed." >&2
    exit "$status"
fi

up_services=(chitragupta chitragupta-ui)
up_orphans=(--remove-orphans)
if ((DEMO_GRAFANA_ENABLED)); then
    up_services+=(grafana)
    up_orphans=()
fi
up_output=
up_status=0
if up_output=$("${COMPOSE[@]}" "${COMPOSE_FILES[@]}" up --detach --wait --force-recreate "${up_orphans[@]}" "${up_services[@]}" 2>&1); then
    up_status=0
else
    up_status=$?
fi
printf '%s\n' "$up_output"
if ((up_status != 0)); then
    diagnose_bind_failure "$up_output"
    retained_failure_diagnostic
    exit "$up_status"
fi

mkdir -p .demo
printf '%s\n' "$DEMO_PROFILE" > .demo/active-profile
echo "Demo services are healthy."
if ((DEMO_LAN_ENABLED)); then
    echo "WARNING: --lan exposes unauthenticated demo services and writable synthetic state to the local network."
fi
echo "UI: http://$DEMO_DISPLAY_HOST:$DEMO_UI_PORT"
echo "API: http://$DEMO_DISPLAY_HOST:$DEMO_API_PORT"
if ((DEMO_GRAFANA_ENABLED)); then
    echo "Grafana: http://$DEMO_DISPLAY_HOST:$DEMO_GRAFANA_PORT"
fi
